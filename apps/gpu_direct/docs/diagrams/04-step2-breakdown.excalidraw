    {
      "id": "key-insight-text",
      "type": "text",
      "x": 105,
      "y": 535,
      "width": 770,
      "height": 50,
      "text": "Key Insight: The actual data transfer (worker_load) went from 23.6s → 0.9s (26x faster).\nThe pause_generation time is unavoidable, but GPU-direct transfer is nearly instant.",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "key-insight-box",
      "originalText": "Key Insight: The actual data transfer (worker_load) went from 23.6s → 0.9s (26x faster).\nThe pause_generation time is unavoidable, but GPU-direct transfer is nearly instant.",
